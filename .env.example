GROQ_API_KEY=your_groq_key_here
FREE_TIER_ONLY=true

CLAUSEGUARD_EXTRACTION_MODEL=openai/gpt-oss-20b
CLAUSEGUARD_REASONING_MODEL=qwen/qwen3.6-27b
CLAUSEGUARD_EMBEDDING_MODEL=local-hash-lexical
CLAUSEGUARD_VERIFIER_MODEL=openai/gpt-oss-120b

# Conservative per-run caps. These stop calls before provider usage can run away.
# Match these to your Groq account limits at https://console.groq.com/settings/limits.
CLAUSEGUARD_MAX_EXTRACTION_REQUESTS=5
CLAUSEGUARD_MAX_EXTRACTION_INPUT_TOKENS=5000
CLAUSEGUARD_MAX_REASONING_REQUESTS=6
CLAUSEGUARD_MAX_REASONING_INPUT_TOKENS=7000
CLAUSEGUARD_MAX_EMBEDDING_REQUESTS=200
CLAUSEGUARD_MAX_EMBEDDING_INPUT_TOKENS=300000
CLAUSEGUARD_MAX_VERIFIER_REQUESTS=5
CLAUSEGUARD_MAX_VERIFIER_INPUT_TOKENS=7000

# Test/demo mode only. Leave false for real agentic cloud runs.
CLAUSEGUARD_MOCK_MODELS=false
